# CIT Scheduler — environment template
#
# The app is hybrid (React SPA + FastAPI + SQLite + CP-SAT). Copy this file to
# `.env` only if you need to override defaults:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.

# --- Backend ---
# Leave empty for same-origin: the Vite dev server proxies /api to 127.0.0.1:8000,
# and the Docker image serves the built SPA and the API from the same origin.
# Set it only if the frontend and API are deployed on different origins.
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_PATH=backend/state.sqlite3
# Week-1 Monday for the display calendar (the dataset ships no dates).
# Defaults to 2026-11-02; change it to move the whole term.
SEMESTER_START_DATE=2026-11-02
# TEAM_NAME=CIT Scheduler
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cit_scheduler
# REDIS_URL=redis://localhost:6379/0
# APP_ENV=development

# --- Demo authentication ---
# Judges use the four documented accounts. Keep the unsigned x-demo-user
# header disabled in any public deployment.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
DEMO_PASSWORD=1234
ALLOW_DEMO_HEADER=0

# --- LLM provider (server-side only) ---
# Never put this key in frontend code. The local-rules fallback keeps the
# manual booking workflow working if every model is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# --- Optional: deployment metadata ---
# APP_BASE_URL=http://localhost:5173

# --- Optional: Vite port override ---
# VITE_PORT=5173
