# CIT Scheduler — environment template
#
# The current build (DEC-001 = A, browser-only) needs NO environment variables.
# Copy this file to `.env` only if you add a backend or an LLM provider:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.

# --- Optional: future backend (D1 = B or C) ---
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cit_scheduler
# REDIS_URL=redis://localhost:6379/0
# APP_ENV=development

# --- Optional: LLM provider adapter (Phase 4) ---
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=

# --- Optional: deployment metadata ---
# APP_BASE_URL=http://localhost:5173

# --- Optional: Vite port override ---
# VITE_PORT=5173
