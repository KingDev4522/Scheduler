# CIT Scheduler — environment template
#
# The app is hybrid (React SPA + FastAPI + SQLite + CP-SAT). Copy this file to
# `.env` only if you need to override defaults:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.

# --- Backend (hybrid D1 = C) ---
# The current hybrid build uses these:
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_PATH=backend/state.sqlite3
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cit_scheduler
# REDIS_URL=redis://localhost:6379/0
# APP_ENV=development

# --- LLM provider (Phase 4) ---
# Server-side only. Never put this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Ordered fallbacks used when a model returns 429/5xx. Booking intake also has
# a deterministic local-rules fallback if every model is unavailable.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# --- Optional: deployment metadata ---
# APP_BASE_URL=http://localhost:5173

# --- Optional: Vite port override ---
# VITE_PORT=5173
